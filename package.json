{
  "name": "pagezero",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "vite build --mode ${CLOUDFLARE_ENV:-production}",
    "check": "oxfmt --check && oxlint && tsc",
    "check:fix": "oxfmt && oxlint --fix",
    "db:clean": "rm -rf ./.wrangler/state/v3/d1",
    "db:drop": "drizzle-kit drop",
    "db:export": "drizzle-kit export > ./packages/db/main/schema.sql",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB_MAIN",
    "db:push": "drizzle-kit push",
    "db:reset": "rm -rf ./packages/db/*/migrations && bun run db:generate --name=init",
    "db:studio": "drizzle-kit studio",
    "deploy:production": "CLOUDFLARE_ENV=production bun run build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview bun run build && wrangler deploy",
    "dev": "NODE_OPTIONS=\"--inspect\" vite dev",
    "dev:email": "email dev -d ./apps/email/templates -p 3001",
    "doctor": "bun run check && bun run test && bun run test:e2e",
    "generate:secret": "bun -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "generate:types": "wrangler types",
    "git:clean": "git branch -l | grep -v 'main' | xargs git branch -D",
    "git:reset": "rm -rf .git && git init .",
    "preview": "NODE_ENV=development CLOUDFLARE_ENV=preview bun run build && vite preview",
    "setup": "bun install && bun run setup:env && playwright install --with-deps chromium && CI=1 bun run db:migrate",
    "setup:env": "cp .init.env .env && cp .init.env.test .env.test",
    "setup:reset": "git clean -fdxq && bun run setup",
    "setup:wrangler": "bun ./packages/config/scripts/wrangler-reset.ts && bun check:fix",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "bun run db:export && bun --bun vitest run",
    "test:coverage": "bun run db:export && bun --bun vitest run --coverage",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "playwright test --ui --project=e2e",
    "test:smoke": "playwright test --project=smoke",
    "test:watch": "bun run db:export && bun --bun vitest watch"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@mdx-js/react": "3.1.1",
    "@polar-sh/better-auth": "1.8.4",
    "@polar-sh/sdk": "0.49.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-start": "1.168.25",
    "@tanstack/virtual-file-routes": "1.162.0",
    "better-auth": "1.6.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "highlight.js": "11.11.1",
    "lucide-react": "1.26.0",
    "motion": "12.42.2",
    "radix-ui": "1.6.5",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-email": "6.9.2",
    "resend": "6.19.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@faker-js/faker": "10.5.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.61.1",
    "@react-email/ui": "6.9.2",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/tanstack-react": "10.4.6",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.0",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "happy-dom": "20.11.12",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "rollup-plugin-visualizer": "7.0.1",
    "storybook": "10.4.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "bun": ">=1.3.1",
    "node": ">=24.11.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "better-sqlite3",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
